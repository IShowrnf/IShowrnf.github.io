/minecraft/textures/blocks/log_spruce_top.png":"","assets/minecraft/textures/blocks/door_spruce_lower.png":"","assets/minecraft/textures/blocks/door_spruce_upper.png":"","assets/minecraft/textures/items/door_spruce.png":"","assets/minecraft/textures/items/spruce_boat.png":"","assets/minecraft/textures/entity/boat/boat_spruce.png":"","assets/minecraft/textures/blocks/planks_birch.png":"","assets/minecraft/textures/blocks/log_birch.png":"","assets/minecraft/textures/blocks/log_birch_top.png":"","assets/minecraft/textures/blocks/door_birch_lower.png":"","assets/minecraft/textures/blocks/door_birch_upper.png":"","assets/minecraft/textures/items/door_birch.png":"","assets/minecraft/textures/items/birch_boat.png":"","assets/minecraft/textures/entity/boat/boat_birch.png":"","assets/minecraft/textures/blocks/planks_jungle.png":"","assets/minecraft/textures/blocks/log_jungle.png":"RklMRS9hc3NldHMvbWluZWNyYWZ0L3RleHR1cmVzL2Jsb2Nrcy9sb2dfanVuZ2xlLnBuZwAAAHuGId2/iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAPUlEQVR42mMMLrb4b2UkyqCmxMdw694nhmPnXjOQwmdioBBQbABjcLHFf0oMYGFgYGAY2mEwasBoOqCKAQArU0ac4xrVogAAAABJRU5ErkJggjo+","assets/minecraft/textures/blocks/log_jungle_top.png":"","assets/minecraft/textures/blocks/door_jungle_lower.png":"","assets/minecraft/textures/blocks/door_jungle_upper.png":"","assets/minecraft/textures/items/door_jungle.png":"","assets/minecraft/textures/items/jungle_boat.png":"","assets/minecraft/textures/entity/boat/boat_jungle.png":"","assets/minecraft/textures/blocks/planks_acacia.png":"","assets/minecraft/textures/blocks/log_acacia.png":"","assets/minecraft/textures/blocks/log_acacia_top.png":"","assets/minecraft/textures/blocks/door_acacia_lower.png":"","assets/minecraft/textures/blocks/door_acacia_upper.png":"","assets/minecraft/textures/items/door_acacia.png":"RklMRS9hc3NldHMvbWluZWNyYWZ0L3RleHR1cmVzL2l0ZW1zL2Rvb3JfYWNhY2lhLnBuZwAAAJ6RqY40iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAYElEQVR42mNgGGjAiMzJMfX+z8fOQVBT25G1cH1MhBSh0+gAxYAXnz+R7AUUAyR4+SgzgBzARLdYEOHmYWBgYGB48/ULebFQtHMh45uvXwZhGAyDdIARjcRomnJ6K1wfAOXeI5QyT13+AAAAAElFTkSuQmCCOj4=","assets/minecraft/textures/items/acacia_boat.png":"","assets/minecraft/textures/entity/boat/boat_acacia.png":"","assets/minecraft/textures/blocks/planks_big_oak.png":"","assets/minecraft/textures/blocks/log_big_oak.png":"","assets/minecraft/textures/blocks/log_big_oak_top.png":"","assets/minecraft/textures/blocks/door_dark_oak_lower.png":"","assets/minecraft/textures/blocks/door_dark_oak_upper.png":"","assets/minecraft/textures/items/door_dark_oak.png":"","assets/minecraft/textures/items/dark_oak_boat.png":"","assets/minecraft/textures/entity/boat/boat_darkoak.png":""},"wind":{"assets/minecraft/textures/items/snowball.png":""}},key='al26-palettes-v1',defaults={deep:false,woods:false,wind:false,wall:'tiles'};let cfg={...defaults};try{const v=JSON.parse(localStorage.getItem(key)||'{}');for(const k of ['deep','woods','wind'])if(typeof v[k]==='boolean')cfg[k]=v[k];if(['polished','bricks','tiles'].includes(v.wall))cfg.wall=v.wall;}catch(e){}const $=id=>document.getElementById(id);for(const k of ['deep','woods','wind'])$('al26-'+k).checked=cfg[k];$('al26-wall').value=cfg.wall;$('al26-status').textContent='Current launch: '+(['deep','woods','wind'].filter(k=>cfg[k]).join(', ')||'original textures');$('al26-save').onclick=()=>{const v={deep:$('al26-deep').checked,woods:$('al26-woods').checked,wind:$('al26-wind').checked,wall:$('al26-wall').value};try{localStorage.setItem(key,JSON.stringify(v));$('al26-status').textContent='Saved. Reopen or refresh the HTML to apply.';}catch(e){$('al26-status').textContent='Browser storage is unavailable.';}};
const from64=s=>{const raw=atob(s),out=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)out[i]=raw.charCodeAt(i);return out;};function to64(b){let s='';for(let i=0;i<b.length;i+=24576)s+=btoa(String.fromCharCode(...b.subarray(i,i+24576)));return s;}
async function transform(bytes,mode){const t=mode==='decompress'?new DecompressionStream('gzip'):new CompressionStream('gzip');return new Uint8Array(await new Response(new Blob([bytes]).stream().pipeThrough(t)).arrayBuffer());}
async function patchArchive(uri,selected){const map={};if(selected.deep)Object.assign(map,PATCH.deep,PATCH['wall_'+selected.wall]);if(selected.woods)Object.assign(map,PATCH.woods);if(selected.wind)Object.assign(map,PATCH.wind);if(!Object.keys(map).length)return uri;const bytes=from64(uri.slice(uri.indexOf(',')+1)),start=123,end=bytes.length-8;if(bytes[start]!==31||bytes[start+1]!==139||new TextDecoder().decode(bytes.subarray(end))!==':::YEE:>')throw Error('Unexpected asset format');const raw=await transform(bytes.subarray(start,end),'decompress'),view=new DataView(raw.buffer),parts=[],seen=new Set(),decoder=new TextDecoder();let p=0;while(p+4<=raw.length){const tag=decoder.decode(raw.subarray(p,p+4));if(tag==='END$'){if(p+4!==raw.length)throw Error('Invalid EPK end');parts.push(raw.subarray(p,p+4));p+=4;break;}const len=raw[p+4],a=p+5+len;if(a+4>raw.length)throw Error('Invalid EPK record');const n=decoder.decode(raw.subarray(p+5,a)),size=view.getUint32(a),e=a+4+size+1;if(e>raw.length||e<=p)throw Error('Invalid EPK length');if(tag==='FILE'&&Object.hasOwn(map,n)){parts.push(from64(map[n]));seen.add(n);}else parts.push(raw.subarray(p,e));p=e;}if(p!==raw.length||seen.size!==Object.keys(map).length)throw Error('Missing palette entries');const zipped=await transform(new Uint8Array(await new Blob(parts).arrayBuffer()),'compress'),out=new Uint8Array(start+zipped.length+8);out.set(bytes.subarray(0,start));out.set(zipped,start);out.set(bytes.subarray(end),start+zipped.length);return 'data:application/octet-stream;base64,'+to64(out);}
window.AL26={patchArchive,async apply(){if(!cfg.deep&&!cfg.woods&&!cfg.wind)return;window.AL12.stage('Applying modern textures',8);try{window.eaglercraftXOpts.assetsURI=await patchArchive(window.eaglercraftXOpts.assetsURI,cfg);$('al26-status').textContent='Active: '+['deep','woods','wind'].filter(k=>cfg[k]).join(', ');}catch(e){$('al26-status').textContent='Palette could not load. Original textures retained.';throw e;}}};})();</script>
</body>
</html>
