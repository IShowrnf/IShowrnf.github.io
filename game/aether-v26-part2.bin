</style><style>#al24-mod-list{display:grid;gap:8px;margin:14px 0}.al24-mod-row{padding:12px;border:1px solid #ffffff18;background:#ffffff05;border-radius:10px}.al24-mod-row strong{font-size:13px}.al24-mod-row p{margin:4px 0 8px}.al24-mod-actions{display:flex;gap:6px;flex-wrap:wrap}.al24-mod-actions button{margin:0!important}.al24-mod-actions button:disabled{opacity:.4}#al24-custom-hud{display:grid;gap:6px}#al24-custom-hud:empty{display:none}#al24-import{width:100%;color:inherit;font:inherit}#al24-mod-status{overflow-wrap:anywhere}</style><style>#al25-list{display:grid;gap:9px;margin:14px 0}.al25-item{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px;background:#ffffff05;border:1px solid #ffffff14;border-radius:10px}.al25-item img{image-rendering:pixelated}.al25-item strong,.al25-item small{display:block}.al25-item small{color:#a1abc0;font-size:11px}.al25-item input{width:100%;box-sizing:border-box;margin-top:5px;font:11px monospace;color:#c7cee0;background:#10131a;border:1px solid #ffffff20;border-radius:5px;padding:5px;user-select:text}.al25-copy{cursor:pointer;background:#262b3c;color:#e3e4f5;border:1px solid #ffffff20;border-radius:6px;padding:8px}</style><style>#al26-palettes{margin-bottom:12px}#al26-palettes label{display:flex;align-items:center;gap:9px;margin:12px 0;color:#e2e6f2}#al26-palettes input{accent-color:var(--al16-accent,#9e90ff)}#al26-palettes select{margin-left:auto;max-width:55%;background:#171c27;color:#e2e6f2;padding:6px;border:1px solid #ffffff24;border-radius:6px}#al26-palettes summary{cursor:pointer;color:#a99cf9}#al26-palettes details{margin-top:12px}#al26-status{min-height:1em}</style></head>
<body style="margin:0px;width:100%;height:100%;overflow:hidden;background-color:#000000;" ><div id="game_frame" style="position:absolute;inset:0;overflow:hidden"></div>
    
    <div id="launch_countdown_screen">
      <div class="al-card">
        <div class="al-mark"><svg width="48" height="48" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5 44 40H34L24 22 14 40H4L24 5Z" fill="currentColor"/><path d="M18 33h12l4 7H14Z" fill="currentColor"/></svg></div>
        <div class="al-word">AETHER <span>LEGIT</span></div><div class="al-meta">1.12.2 &nbsp; / &nbsp; STUDIO EDITION</div>
        <div class="al-line"></div><div class="al-status"><span>Starting client</span><span><span id="launchCountdownNumber">5</span>s</span></div>
        <div class="al-progress"><div id="launchCountdownProgress"></div></div>
        <button id="skipCountdown" class="al-button" autofocus>Launch now</button>
        <div class="al-foot">Right Shift: Aether modules &nbsp; · &nbsp; Esc: close menu</div>
      </div><div class="al-version">AETHER LEGIT &nbsp; / &nbsp; V2.6</div>
    </div>
<div id="al13-stage-badge" hidden><span>◆</span><div><small></small><strong></strong></div><em>AETHER LEGIT / 2.6</em></div><div id="al12-root" hidden><div id="al21-guide" hidden><small>SCHEMATIC GUIDE</small><canvas id="al21-mini" width="1" height="1"></canvas><span id="al21-mini-label"></span></div>
 <button id="al13-entry" hidden>◆ OPEN AETHER GUI · RSHIFT</button><div class="al12-hud">
  <div class="al12-widget" data-widget="keys" hidden><div class="al12-keys"><span></span><span class="al12-key" data-key="KeyW">W</span><span></span><span class="al12-key" data-key="KeyA">A</span><span class="al12-key" data-key="KeyS">S</span><span class="al12-key" data-key="KeyD">D</span><span class="al12-key" data-key="Space">SPACE</span></div></div>
  <div class="al12-widget" data-widget="cps" hidden><div class="al12-label">Clicks per second</div><div class="al12-value" id="al12-cps">0 L · 0 R</div></div>
  <div class="al12-widget" data-widget="frame" hidden><div class="al12-label">Frame time</div><div class="al12-value" id="al12-ms">— ms</div><svg class="al12-graph" viewBox="0 0 120 27"><path d="M0 26H120" stroke="#526185" fill="none"/><polyline id="al12-line" fill="none" stroke="#a694ff" stroke-width="1.5" points=""/></svg></div>
  <div class="al12-widget" data-widget="timer" hidden><div class="al12-label">World session</div><div class="al12-value" id="al12-time">00:00</div></div>
  <div class="al12-widget" data-widget="clock" hidden><div class="al12-label">Local time</div><div class="al12-value" id="al12-clock">—</div></div>
  <div class="al12-widget" data-widget="fps" hidden><div class="al12-label">Live FPS</div><div class="al12-value" id="al13-fps">0 FPS</div></div>
  <div class="al12-widget" data-widget="clicks" hidden><div class="al12-label">Session clicks</div><div class="al12-value" id="al13-clicks">0</div></div>
  <div class="al12-widget" data-widget="focus" hidden><div class="al12-label">Active play time</div><div class="al12-value" id="al13-focus">0m 0s</div></div>
 <div class="al12-widget" data-widget="coords" hidden><div class="al12-label">Coordinates</div><div class="al12-value" id="al16-coords">—</div></div><div class="al12-widget" data-widget="speed" hidden><div class="al12-label">Movement speed</div><div class="al12-value" id="al16-speed">—</div></div><div class="al12-widget" data-widget="direction" hidden><div class="al12-label">Facing</div><div class="al12-value" id="al16-direction">—</div></div><div class="al12-widget" data-widget="cooldown" hidden><div class="al12-label">Attack cooldown</div><div class="al12-value" id="al23-cooldown">—</div><div class="al23-track"><div class="al23-fill" id="al23-charge"></div></div></div><div class="al12-widget" data-widget="vitals" hidden><div class="al12-label">Combat vitals</div><div class="al12-value" id="al23-health">— HP</div><div class="al23-sub" id="al23-food">— food</div></div><div class="al12-widget" data-widget="peak" hidden><div class="al12-label">Peak CPS</div><div class="al12-value" id="al23-peak">0 L · 0 R</div></div><div class="al12-widget" data-widget="mouse" hidden><div class="al12-label">Mouse buttons</div><div class="al23-mouse"><span class="al12-key" id="al23-lmb">LMB</span><span class="al12-key" id="al23-rmb">RMB</span></div></div><div class="al12-widget" data-widget="rhythm" hidden><div class="al12-label">Click interval</div><div class="al12-value" id="al23-rhythm">— ms</div></div><div class="al12-widget" data-widget="dispatch" hidden><div class="al12-label">Attack dispatch</div><div class="al12-value" id="al24-dispatch">—</div><div class="al12-label" id="al24-dispatch-detail">Local processing only</div></div><div id="al24-custom-hud"></div></div><div class="al16-cross" data-widget="cross" hidden>+</div><div class="al16-mark" data-widget="mark" hidden>AETHER <span>LEGIT</span></div>
 <div class="al12-menu" role="dialog" aria-label="Aether Legit menu" tabindex="-1" hidden><aside class="al16-side"><div class="al16-brand"><div class="al16-logo">Λ</div><div><strong>Aether Legit</strong><small>1.12.2 / v2.6</small></div></div><button class="al16-nav" data-tab="All modules" aria-selected="true"><span>▦</span>All modules</button><button class="al16-nav" data-tab="HUD" aria-selected="false"><span>⌖</span>HUD</button><button class="al16-nav" data-tab="PvP" aria-selected="false"><span>⚔</span>PvP</button><button class="al16-nav" data-tab="Performance" aria-selected="false"><span>∿</span>Performance</button><button class="al16-nav" data-tab="Session" aria-selected="false"><span>◷</span>Session</button><button class="al16-nav" data-tab="Cosmetics" aria-selected="false"><span>◇</span>Cosmetics</button><button class="al16-nav" data-tab="ViaVersion" aria-selected="false"><span>⇄</span>ViaVersion</button><button class="al16-nav" data-tab="Schematics" aria-selected="false"><span>▧</span>Schematics</button><button class="al16-nav" data-tab="Mods" aria-selected="false"><span>⊞</span>Mods</button><button class="al16-nav" data-tab="Modern Items" aria-selected="false"><span>◇</span>Modern Items</button><button class="al16-nav" data-tab="Settings" aria-selected="false"><span>⚙</span>Settings</button><div class="al16-side-foot"><b id="al12-active-count">0 / 23 enabled</b>STUDIO EDITION</div></aside><section class="al16-main"><header class="al16-head"><div><div class="al16-kicker">AETHER / CLIENT STUDIO</div><h2 id="al16-title">All modules</h2></div><button class="al12-close" aria-label="Close">×</button></header><div class="al16-toolbar" id="al16-toolbar"><input class="al16-search" id="al16-search" placeholder="Search modules…" aria-label="Search modules"><span class="al16-count" id="al16-count"></span></div><div class="al16-body"><section id="al16-mods"><div class="al12-grid"><button class="al12-option" data-module="keys" data-cat="HUD" aria-pressed="false"><span class="al12-hotkey">⌨</span><span class="al12-option-copy"><strong>Keystrokes</strong><small>Movement and jump keys</small></span><b>Off</b></button><button class="al12-option" data-module="cps" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">↗</span><span class="al12-option-copy"><strong>CPS Counter</strong><small>Left and right clicks per second</small></span><b>Off</b></button><button class="al12-option" data-module="frame" data-cat="Performance" aria-pressed="false"><span class="al12-hotkey">∿</span><span class="al12-option-copy"><strong>Frame-Time Graph</strong><small>Frame pacing and spikes</small></span><b>Off</b></button><button class="al12-option" data-module="timer" data-cat="Session" aria-pressed="false"><span class="al12-hotkey">◷</span><span class="al12-option-copy"><strong>World Timer</strong><small>Elapsed time in this world</small></span><b>Off</b></button><button class="al12-option" data-module="clock" data-cat="Session" aria-pressed="false"><span class="al12-hotkey">◴</span><span class="al12-option-copy"><strong>Local Clock</strong><small>Your local time</small></span><b>Off</b></button><button class="al12-option" data-module="fps" data-cat="Performance" aria-pressed="false"><span class="al12-hotkey">◫</span><span class="al12-option-copy"><strong>Live FPS</strong><small>Measured game frames per second</small></span><b>Off</b></button><button class="al12-option" data-module="clicks" data-cat="Session" aria-pressed="false"><span class="al12-hotkey">◎</span><span class="al12-option-copy"><strong>Session Clicks</strong><small>Total gameplay mouse clicks</small></span><b>Off</b></button><button class="al12-option" data-module="focus" data-cat="Session" aria-pressed="false"><span class="al12-hotkey">◉</span><span class="al12-option-copy"><strong>Active Play Time</strong><small>Time with the game focused</small></span><b>Off</b></button><button class="al12-option" data-module="coords" data-cat="HUD" aria-pressed="false"><span class="al12-hotkey">⌖</span><span class="al12-option-copy"><strong>Coordinates</strong><small>Current X, Y and Z</small></span><b>Off</b></button><button class="al12-option" data-module="speed" data-cat="HUD" aria-pressed="false"><span class="al12-hotkey">➜</span><span class="al12-option-copy"><strong>Movement Speed</strong><small>Horizontal blocks per second</small></span><b>Off</b></button><button class="al12-option" data-module="direction" data-cat="HUD" aria-pressed="false"><span class="al12-hotkey">◇</span><span class="al12-option-copy"><strong>Direction</strong><small>Facing and yaw</small></span><b>Off</b></button><button class="al12-option" data-module="cross" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">+</span><span class="al12-option-copy"><strong>Accent Crosshair</strong><small>Cosmetic center marker</small></span><b>Off</b></button><button class="al12-option" data-module="mark" data-cat="HUD" aria-pressed="false"><span class="al12-hotkey">◆</span><span class="al12-option-copy"><strong>Watermark</strong><small>Aether Legit branding</small></span><b>Off</b></button><button class="al12-option" data-module="cooldown" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">◴</span><span class="al12-option-copy"><strong>Attack Cooldown</strong><small>Native attack recharge percentage</small></span><b>Off</b></button><button class="al12-option" data-module="vitals" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">♥</span><span class="al12-option-copy"><strong>Combat Vitals</strong><small>Live health and food points</small></span><b>Off</b></button><button class="al12-option" data-module="peak" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">↗</span><span class="al12-option-copy"><strong>Peak CPS</strong><small>Highest left and right CPS this world</small></span><b>Off</b></button><button class="al12-option" data-module="mouse" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">◫</span><span class="al12-option-copy"><strong>Mouse Buttons</strong><small>Live left and right button state</small></span><b>Off</b></button><button class="al12-option" data-module="rhythm" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">∿</span><span class="al12-option-copy"><strong>Click Timing</strong><small>Average recent left-click interval</small></span><b>Off</b></button><button class="al12-option" data-module="playerboxes" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">□</span><span class="al12-option-copy"><strong>Player Hitboxes</strong><small>Native 3D player collision bounds</small></span><b>Off</b></button><button class="al12-option" data-module="itemboxes" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">◇</span><span class="al12-option-copy"><strong>Item Hitboxes</strong><small>Native dropped-item collision bounds</small></span><b>Off</b></button><button class="al12-option" data-module="dispatch" data-cat="PvP" aria-pressed="false"><span class="al12-hotkey">↗</span><span class="al12-option-copy"><strong>Hit Dispatch</strong><small>Local input to attack dispatch time</small></span><b>Off</b></button><button class="al12-option" data-module="particles" data-cat="Performance" aria-pressed="false"><span class="al12-hotkey">✧</span><span class="al12-option-copy"><strong>Reduced Particles</strong><small>Native minimal particles and weather effects</small></span><b>Off</b></button><button class="al12-option" data-module="clouds" data-cat="Performance" aria-pressed="false"><span class="al12-hotkey">☁</span><span class="al12-option-copy"><strong>Cloud Culling</strong><small>Skip cloud rendering</small></span><b>Off</b></button></div><p id="al16-empty" hidden>No matching modules.</p></section><section id="al16-cosmetics" hidden><div class="al16-card"><div class="al18-overline">AETHER ATELIER / REFINED COLLECTION</div><h3>Cosmetic studio</h3><p>Original color and silhouette variants rendered locally on your player. Use Minecraft’s third-person camera (normally F5) to see them in a world.</p><div class="al16-cos-grid"><div><div class="al16-preview" id="al18-cape-preview"></div><label for="al16-cape">Cape collection</label><select id="al16-cape" disabled><option>Waiting for game…</option></select></div><div><div class="al16-preview" id="al18-hat-preview"></div><label for="al16-hat">Headwear collection</label><select id="al16-hat" disabled><option>Waiting for game…</option></select></div></div><div class="al18-preset"><button class="al16-action" data-kit="0,0">Noir set</button><button class="al16-action" data-kit="1,2">Arctic set</button><button class="al16-action" data-kit="2,1">Ivory set</button><button class="al16-action" data-kit="3,4">Crimson set</button><button class="al16-action" data-kit="-1,-1">Clear</button></div><p class="al16-status" id="al16-cos-status" role="status">Waiting for native renderer.</p><p>Previews are stylized icons, not screenshots. Cosmetics are local-only; they do not alter armor or hitboxes.</p></div></section><section id="al16-via" hidden><div class="al16-card"><h3>Server compatibility</h3><p>Native protocol: Minecraft 1.12.2 (340). This panel saves your target version and WebSocket server address; it does not translate packets.</p><label for="al16-version">Target server version</label><select id="al16-version"><option>1.8.x</option><option selected>1.12.2</option><option>1.16.x</option><option>1.18.x</option><option>1.19.x</option><option>1.20.x</option><option>1.21.x</option><option>26.x / newer</option></select><label for="al16-address">Eaglercraft WebSocket address</label><input id="al16-address" placeholder="wss://your-server.example" spellcheck="false"><p id="al16-via-info"></p><button class="al16-action" id="al16-copy">Copy server address</button><p class="al16-status" id="al16-via-status"></p></div><div class="al16-card"><h3>Connection requirements</h3><p>Join using the normal Multiplayer menu with an Eaglercraft-compatible WebSocket endpoint. For newer servers the server owner must provide a bridge and ViaBackwards/ViaVersion. Older servers may require ViaRewind. Unsupported servers cannot be fixed by selecting a version here.</p></div></section><section id="al21-schematics" hidden><div class="al16-card al21-card"><h3>Schematic studio</h3><p>Import a local Litematica or classic schematic. Build manually with the layer guide and block counts.</p><label for="al21-file">Schematic file</label><input id="al21-file" type="file" accept=".litematic,.schematic,.nbt"><p id="al21-status" role="status">No schematic loaded.</p><label for="al21-region">Region</label><select id="al21-region" disabled></select><p id="al21-size"></p><div class="al21-layer"><button id="al21-prev">−</button><input type="range" id="al21-layer" min="0" max="0" value="0" disabled><button id="al21-next">+</button></div><p id="al21-layer-label">Select a file first</p><div class="al21-layout"><div class="al21-canvas"><canvas id="al21-preview" width="1" height="1"></canvas></div><div><h3>Block counts</h3><label class="al21-check"><input type="checkbox" id="al21-layer-only">Current layer only</label><div id="al21-materials"></div></div></div><label class="al21-check"><input type="checkbox" id="al21-show">Show layer guide while playing</label><button id="al21-export">Export material list</button><p>2D guide only · no ghost blocks, automatic placement or inventory checking. Modern block names may not exist in 1.12.2.</p></div></section><section id="al24-mods" hidden><div class="al16-card"><div class="al18-overline">AETHER / MOD LOADER 1</div><h3>Installed browser mods</h3><p>Import local .aethermod or JSON files to add configurable live HUD widgets and module presets. No Java or executable JavaScript is run.</p><label for="al24-import">Import mod file</label><input id="al24-import" type="file" accept=".aethermod,.json,application/json"><p id="al24-mod-status" role="status">Ready to import.</p><div id="al24-mod-list"></div><button class="al16-action" id="al24-example">Install example mod</button><div class="al18-divider"></div><h3>Compatibility</h3><p>OptiFine and BetterHitReg JAR files require a desktop Java runtime or a source-level port. This loader supports Aether declarative mods only. Reduced Particles and Cloud Culling are native Aether controls; Hit Dispatch measures local processing, not server hit confirmation.</p></div></section><section id="al25-items" hidden><div class="al16-card" id="al26-palettes"><div class="al18-overline">AETHER / 26.2 BLOCK PALETTES</div><h3>Modern building styles</h3><p>Optional visual replacements for existing 1.12.2 blocks. Changing a palette requires a client reload; all matching blocks in your world change appearance. No new block IDs, crafting or abilities.</p><label><input type="checkbox" id="al26-deep"> Deepslate construction and ores</label><label><input type="checkbox" id="al26-woods"> Six newer wood palettes</label><label><input type="checkbox" id="al26-wind"> Wind charge appearance (snowballs)</label><label>Second wall style <select id="al26-wall"><option value="polished">Polished deepslate</option><option value="bricks">Deepslate bricks</option><option value="tiles">Deepslate tiles</option></select></label><button class="al16-action" type="button" id="al26-save">Save for next launch</button><p id="al26-status" role="status"></p><details><summary>Block and item mappings</summary><p>Deepslate: andesite. Cobbled: cobblestone. Polished: stone bricks. Bricks: clay bricks. Tiles: nether bricks. Slabs and stairs follow their base blocks. Walls: cobblestone and mossy cobblestone (second wall style). Chiseled: chiseled stone bricks. Cracked bricks: cracked stone bricks. Cracked tiles: red nether bricks. Reinforced: bedrock. Infested: infested cobblestone uses the cobbled texture (not true infested deepslate). Ores use existing ore blocks; copper is a quartz ore visual proxy.</p><p>Wood palette: oak → mangrove, spruce → cherry, birch → pale oak, jungle → bamboo, acacia → crimson, dark oak → warped. Planks, logs, slabs, stairs, fences, gates, doors and boats use legacy behavior. Leaves and other missing native wood forms are not changed.</p><p>Wind charge: snowball appearance only; no wind burst. Mace: unbreakable iron axe visual variant from the catalog below; no smash attack.</p></details></div><div class="al16-card"><div class="al18-overline">AETHER / MODERN COLLECTION</div><h3>Modern item styles</h3><p>Original 26.2-inspired visuals. These are 1.12.2 model variants, not new registered items. Use the command in a world with cheats or on a server where you have permission. They are unbreakable base items; modern abilities are not included. Normal items keep their normal models.</p><div id="al25-list"><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Wind Charge</strong><small>Snowball visual proxy · enable the palette above first</small><input readonly aria-label="Give command for Wind Charge" value="/give @p minecraft:snowball 16 0 {display:{Name:&quot;Wind Charge (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Netherite Sword</strong><small>Visual variant · diamond sword mechanics</small><input readonly aria-label="Give command for Netherite Sword" value="/give @p minecraft:diamond_sword 1 1 {Unbreakable:1b,display:{Name:&quot;Netherite Sword (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Netherite Pickaxe</strong><small>Visual variant · diamond pickaxe mechanics</small><input readonly aria-label="Give command for Netherite Pickaxe" value="/give @p minecraft:diamond_pickaxe 1 1 {Unbreakable:1b,display:{Name:&quot;Netherite Pickaxe (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Copper Sword</strong><small>Visual variant · stone sword mechanics</small><input readonly aria-label="Give command for Copper Sword" value="/give @p minecraft:stone_sword 1 1 {Unbreakable:1b,display:{Name:&quot;Copper Sword (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Mace</strong><small>Visual variant · iron axe mechanics</small><input readonly aria-label="Give command for Mace" value="/give @p minecraft:iron_axe 1 1 {Unbreakable:1b,display:{Name:&quot;Mace (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Trident</strong><small>Visual variant · iron shovel mechanics</small><input readonly aria-label="Give command for Trident" value="/give @p minecraft:iron_shovel 1 1 {Unbreakable:1b,display:{Name:&quot;Trident (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Diamond Spear</strong><small>Visual variant · iron sword mechanics</small><input readonly aria-label="Give command for Diamond Spear" value="/give @p minecraft:iron_sword 1 1 {Unbreakable:1b,display:{Name:&quot;Diamond Spear (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Brush</strong><small>Visual variant · shears mechanics</small><input readonly aria-label="Give command for Brush" value="/give @p minecraft:shears 1 1 {Unbreakable:1b,display:{Name:&quot;Brush (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div><div class="al25-item"><img width="48" height="48" alt="" src="data:image/png;base64,"><div><strong>Sulfur Spike</strong><small>Visual variant · golden shovel mechanics</small><input readonly aria-label="Give command for Sulfur Spike" value="/give @p minecraft:golden_shovel 1 1 {Unbreakable:1b,display:{Name:&quot;Sulfur Spike (style)&quot;}}"></div><button type="button" class="al25-copy">Copy</button></div></div><p id="al25-status" aria-live="polite">Copy a command, then paste it into Minecraft chat.</p></div></section><section id="al16-settings" hidden><div class="al16-card"><h3>Appearance</h3><label for="al16-theme">Accent color</label><select id="al16-theme"><option value="violet">Amethyst</option><option value="cyan">Glacier</option><option value="gold">Solar Gold</option><option value="rose">Rose</option><option value="mint">Mint</option></select><label for="al18-native">Native Minecraft menus</label><select id="al18-native"><option value="theme">Aether theme</option><option value="original">Original appearance</option></select><label for="al18-surface">Menu background</label><select id="al18-surface"><option value="obsidian">Obsidian</option><option value="nebula">Nebula</option><option value="midnight">Midnight</option><option value="forest">Forest</option><option value="ember">Ember</option></select><div class="al18-divider"></div><h3>Chat appearance</h3><label for="al22-chat">Message background</label><select id="al22-chat"><option value="0">Minimal — text only</option><option value="1">Compact — fit to text</option><option value="2">Classic — full width</option></select><label for="al23-input-mode">Input appearance</label><select id="al23-input-mode"><option value="0">Minimal underline</option><option value="1">Floating text — no box</option><option value="2">Soft dark bar</option></select><div id="al22-chat-preview" aria-label="Chat style preview"><div class="al22-lines"><div><span style="color:#a9e6ac">Player</span> » gg</div><div><span style="color:#a59bff">Aether</span> » Welcome back!</div><div>Anyone down for PvP?</div></div><div class="al22-input">/msg <span>▏</span></div></div><p>Preserves server text colors, links and chat fading. Uses the original Minecraft input.</p><div class="al18-divider"></div><h3>Individual menu overrides</h3><p>Choose a different look for the native menu you are currently visiting. Open this studio with Right Shift while on that menu.</p><label for="al18-screen">Menu</label><select id="al18-screen"></select><label for="al18-override">Background override</label><select id="al18-override"><option value="inherit">Use global theme</option><option value="obsidian">Obsidian</option><option value="nebula">Nebula</option><option value="midnight">Midnight</option><option value="forest">Forest</option><option value="ember">Ember</option><option value="original">Original appearance</option></select><button class="al16-action" id="al18-reset-theme">Reset menu themes</button><button class="al16-action" id="al16-reset-pos">Reset menu position</button><button class="al16-action" id="al16-reset-mods">Reset modules</button></div></section></div><footer class="al16-footer"><span>RSHIFT · ESC to close</span><span>Drag the header to move · Resume from pause after closing</span></footer></section></div>
</div>
<script>
(function(){'use strict';
 const $=id=>document.getElementById(id),root=$('al12-root'),menu=root.querySelector('.al12-menu'),hud=root.querySelector('.al12-hud'),names=['keys', 'cps', 'frame', 'timer', 'clock', 'fps', 'clicks', 'focus', 'coords', 'speed', 'direction', 'cross', 'mark', 'cooldown', 'vitals', 'peak', 'mouse', 'rhythm','playerboxes','itemboxes','dispatch','particles','clouds'];
 // Place overlays outside Eaglercraft's body game container so its initialization cannot remove them.
 document.body.appendChild(root);let pos=null,mc=null,world=null,screen='boot',started=0,open=false,cover=null,bootTimeout=0,finished=false,last=0,samples=[],left=[],right=[],pressed=new Set(),active=false;
 let nativeClickAt=0,rawClickAt=0,dispatchMs=null,dispatchCount=0,dispatchAt=0;let combat={health:null,cooldown:null,player:null},peakL=0,peakR=0,mouseHeld=new Set(),intervals=[],lastClick=0;
 let cfg={keys:true,cps:true,frame:true,timer:false,clock:false,fps:true,clicks:false,focus:false,coords:false,speed:false,direction:false,cross:false,mark:false,cooldown:false,vitals:false,peak:false,mouse:false,rhythm:false,playerboxes:false,itemboxes:false,dispatch:false,particles:false,clouds:false};const defaults={...cfg};let frameCount=0,fps=0,fpsAt=performance.now(),totalClicks=0,focusMs=0,focusAt=performance.now();try{const saved=JSON.parse(localStorage.getItem('aetherLegitHUD12')||'{}');for(const n of names)if(typeof saved[n]==='boolean')cfg[n]=saved[n];}catch(e){}
 function refresh(){let enabled=0;for(const n of names){const w=root.querySelector('[data-widget="'+n+'"]'),b=root.querySelector('[data-module="'+n+'"]');if(w)w.hidden=!cfg[n]||((n==='cross'||n==='mark')&&(!active||open));if(cfg[n])enabled++;b.setAttribute('aria-pressed',String(cfg[n]));b.querySelector('b').textContent=cfg[n]?'Enabled':'Off';}$('al12-active-count').textContent=enabled+' / '+names.length+' enabled';}
 function toggle(n){cfg[n]=!cfg[n];try{localStorage.setItem('aetherLegitHUD12',JSON.stringify(cfg));}catch(e){}refresh();}
 function panel(v){if(open===v)return;open=v;menu.hidden=!v;root.classList.toggle('al14-open',v);if(v){root.hidden=false;clear();if(document.pointerLockElement&&document.exitPointerLock)try{document.exitPointerLock();}catch(e){}menu.focus({preventScroll:true});}else{clear();if(root.contains(document.activeElement))document.activeElement.blur();}update();}
 function clear(){pressed.clear();left=[];right=[];mouseHeld.clear();intervals=[];lastClick=0;}
 function worldState(){const w=mc&&mc.r||null;if(w!==world){world=w;started=w?performance.now():0;last=0;samples=[];peakL=peakR=0;nativeClickAt=rawClickAt=dispatchCount=dispatchAt=0;dispatchMs=null;combat={health:null,cooldown:null,player:null};clear();if(!w)panel(false);} active=!!(w&&mc.a&&mc.bD===null&&!(mc.w&&mc.w.fq));return active;}
 function update(){worldState();const now=performance.now();if(active&&!open&&!document.hidden&&document.hasFocus())focusMs+=Math.min(250,now-focusAt);focusAt=now;root.hidden=!(active||open||screen==='main'||screen==='pause');hud.hidden=!active||open;if(window.AL21Guide)window.AL21Guide.update(active,open);for(const n of ['cross','mark'])root.querySelector('[data-widget="'+n+'"]').hidden=!active||open||!cfg[n];$('al13-entry').hidden=open||!(screen==='main'||screen==='pause'||active);if(!active)return;if(cfg.dispatch){$('al24-dispatch').textContent=dispatchMs===null?'—':Math.round(dispatchMs)+' ms';$('al24-dispatch-detail').textContent=dispatchCount+' dispatched · local only';}if(window.AL24Mods)window.AL24Mods.tick();left=left.filter(t=>now-t<1000);right=right.filter(t=>now-t<1000);peakL=Math.max(peakL,left.length);peakR=Math.max(peakR,right.length);if(cfg.peak)$('al23-peak').textContent=peakL+' L · '+peakR+' R';if(cfg.mouse){$('al23-lmb').classList.toggle('on',mouseHeld.has(0));$('al23-rmb').classList.toggle('on',mouseHeld.has(2));}if(cfg.rhythm)$('al23-rhythm').textContent=intervals.length&&now-lastClick<1800?Math.round(intervals.reduce((a,b)=>a+b,0)/intervals.length)+' ms':'— ms';if(cfg.cooldown){const n=combat.player===mc.a&&combat.cooldown!==null?Math.round(combat.cooldown*100):null;$('al23-cooldown').textContent=n===null?'—':n+'%';$('al23-charge').style.width=(n??0)+'%';}if(cfg.vitals){const health=combat.player===mc.a?combat.health:null,food=mc.a&&mc.a.k6&&mc.a.k6.r4;$('al23-health').textContent=(Number.isFinite(health)?Number(health.toFixed(1)):'—')+' HP';$('al23-food').textContent=(Number.isFinite(food)?food:'—')+' / 20 food';}for(const k of root.querySelectorAll('[data-key]'))k.classList.toggle('on',pressed.has(k.dataset.key));if(cfg.cps)$('al12-cps').textContent=left.length+' L · '+right.length+' R';if(cfg.fps)$('al13-fps').textContent=fps+' FPS';if(cfg.clicks)$('al13-clicks').textContent=String(totalClicks);if(cfg.focus)$('al13-focus').textContent=Math.floor(focusMs/60000)+'m '+Math.floor(focusMs/1000)%60+'s';if(cfg.frame){const a=samples.slice(-60);$('al12-ms').textContent=a.length?(a.reduce((x,y)=>x+y,0)/a.length).toFixed(1)+' ms':'— ms';$('al12-line').setAttribute('points',a.map((v,i)=>(i*2)+','+(26-Math.min(v,80)/80*25)).join(' '));}if(cfg.timer){const sec=Math.max(0,Math.floor((now-started)/1000)),h=Math.floor(sec/3600),m=Math.floor(sec/60)%60; $('al12-time').textContent=(h?h+':':'')+String(m).padStart(2,'0')+':'+String(sec%60).padStart(2,'0');}if(cfg.clock)$('al12-clock').textContent=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});const p=mc&&mc.a;if(p&&[p.c,p.f,p.d].every(Number.isFinite)){if(cfg.coords)$('al16-coords').textContent=[p.c,p.f,p.d].map(Math.floor).join(' / ');let v=0;if(pos&&pos.w===world&&now-pos.t>0&&now-pos.t<1000){const dist=Math.hypot(p.c-pos.x,p.d-pos.z);if(dist<12)v=dist*1000/(now-pos.t);}pos={w:world,x:p.c,z:p.d,t:now};if(cfg.speed)$('al16-speed').textContent=v.toFixed(1)+' b/s';if(cfg.direction&&Number.isFinite(p.y)){const yaw=(p.y%360+360)%360;$('al16-direction').textContent=['S','SW','W','NW','N','NE','E','SE'][Math.round(yaw/45)%8]+' · '+Math.round(yaw)+'°';}}}
 function stop(e){e.preventDefault();e.stopImmediatePropagation();}
 const captured=new Set();
 function rightShift(e){return e.code==='ShiftRight'||(!e.code&&e.key==='Shift'&&e.location===2);}
 window.addEventListener('keydown',e=>{const isRight=rightShift(e);if(isRight&&(worldState()||open||screen==='main'||screen==='pause'||(screen==='other'&&!/chat|disconnect|connecting/i.test(nativeScreenKey()))||captured.has(e.code))){stop(e);captured.add(e.code);if(!e.repeat)panel(!open);return;}if(open){if(e.code!=='Escape'&&root.contains(document.activeElement)&&['INPUT','SELECT','TEXTAREA'].includes(document.activeElement.tagName)){e.stopImmediatePropagation();return;}if(e.code==='Tab') {e.stopImmediatePropagation();return;}if((e.code==='Enter'||e.code==='Space')&&root.contains(document.activeElement)){e.stopImmediatePropagation();return;}stop(e);captured.add(e.code);if(!e.repeat){if(e.code==='Escape')panel(false);else if(/^Digit[1-8]$/.test(e.code))toggle(names[Number(e.code.slice(-1))-1]);}return;}if(worldState())pressed.add(e.code);},true);
 window.addEventListener('keyup',e=>{pressed.delete(e.code);if(captured.delete(e.code))stop(e);},true);window.addEventListener('blur',()=>{captured.clear();clear();});document.addEventListener('visibilitychange',()=>{if(document.hidden)clear();});window.addEventListener('mousedown',e=>{if(!worldState()||open||root.contains(e.target))return;const n=performance.now();mouseHeld.add(e.button);if(e.button===0){rawClickAt=n;left=left.filter(t=>n-t<1000);left.push(n);peakL=Math.max(peakL,left.length);if(lastClick&&n-lastClick<1800){intervals.push(n-lastClick);if(intervals.length>6)intervals.shift();}else intervals=[];lastClick=n;totalClicks++;}if(e.button===2){right=right.filter(t=>n-t<1000);right.push(n);peakR=Math.max(peakR,right.length);totalClicks++;}},true);window.addEventListener('mouseup',e=>mouseHeld.delete(e.button),true);
 for(const type of ['mousedown','mouseup','mousemove','click','wheel','contextmenu','pointerdown','pointerup'])root.addEventListener(type,e=>{if(open||root.contains(e.target)){e.stopPropagation();if(type==='contextmenu'||(open&&e.target===root))e.preventDefault();}});
 for(const b of root.querySelectorAll('[data-module]'))b.addEventListener('click',()=>toggle(b.dataset.module));for(const b of root.querySelectorAll('.al12-close'))b.addEventListener('click',()=>panel(false));$('al13-entry').addEventListener('click',()=>panel(true));refresh();setInterval(update,100);
 let tab='All modules',queue=[],catalog=null;const search=$('al16-search');function filter(){const q=search.value.toLowerCase().trim();let count=0;for(const b of root.querySelectorAll('[data-module]')){b.hidden=!(tab==='All modules'||b.dataset.cat===tab)||!b.textContent.toLowerCase().includes(q);if(!b.hidden)count++;}$('al16-count').textContent=count+' modules';$('al16-empty').hidden=count!==0;}function selectTab(t){tab=t;$('al16-title').textContent=t;for(const b of root.querySelectorAll('[data-tab]'))b.setAttribute('aria-selected',String(b.dataset.tab===t));const special=['Cosmetics','ViaVersion','Settings','Schematics','Mods','Modern Items'].includes(t);$('al16-toolbar').hidden=special;$('al16-mods').hidden=special;for(const [id,name] of [['al16-cosmetics','Cosmetics'],['al16-via','ViaVersion'],['al16-settings','Settings'],['al21-schematics','Schematics'],['al24-mods','Mods'],['al25-items','Modern Items']])$(id).hidden=t!==name;filter();}for(const b of root.querySelectorAll('[data-tab]'))b.onclick=()=>selectTab(b.dataset.tab);search.oninput=filter;filter();
 const theme=$('al16-theme'),palette={violet:'#a59bff',cyan:'#72d9ee',gold:'#f1c477',rose:'#f49fbd',mint:'#8de0bb'};function load(k,d){try{return localStorage.getItem(k)||d;}catch(e){return d;}}function save(k,v){try{localStorage.setItem(k,v);}catch(e){}}function applyTheme(){root.style.setProperty('--accent',palette[theme.value]||palette.violet);save('al16-theme',theme.value);}theme.value=load('al16-theme','violet');applyTheme();theme.onchange=applyTheme;
 const palettes={obsidian:[0x161923,0x090B12],nebula:[0x382B65,0x101326],midnight:[0x17334A,0x090F20],forest:[0x173C35,0x0A1B18],ember:[0x482332,0x1B0D17]},nativeMode=$('al18-native'),surface=$('al18-surface'),screenSelect=$('al18-screen'),overrideSelect=$('al18-override');let knownScreens=new Map(),overrides=Object.create(null),lastNative=null;
 try{const saved=JSON.parse(load('al18-overrides','{}'));for(const [k,v] of Object.entries(saved))if(v==='original'||Object.hasOwn(palettes,v))overrides[k]=v;}catch(e){}nativeMode.value=load('al18-native','theme')==='original'?'original':'theme';surface.value=Object.hasOwn(palettes,load('al18-surface','obsidian'))?load('al18-surface','obsidian'):'obsidian';
 function nativeScreenKey(o=mc&&mc.bD){if(!o)return 'world';const m=o.constructor&&o.constructor.$meta;return m&&m.name?m.name:o.constructor&&o.constructor.name||'unknown';}
 function niceScreen(k){return k==='world'?'In-game / no menu':k.split('.').pop().replace(/^Gui/,'').replace(/([a-z])([A-Z])/g,'$1 $2');}
 function trackScreen(o){const k=nativeScreenKey(o);if(k==='world')return;if(!knownScreens.has(k)){knownScreens.set(k,niceScreen(k));screenSelect.add(new Option(niceScreen(k),k));}if(lastNative!==k){lastNative=k;screenSelect.value=k;overrideSelect.value=overrides[k]||'inherit';}}
 for(const k of Object.keys(overrides)){knownScreens.set(k,niceScreen(k));screenSelect.add(new Option(niceScreen(k),k));}if(!screenSelect.options.length)screenSelect.add(new Option('Visit a native menu first',''));
 function nativeTheme(){if(nativeMode.value==='original')return null;const key=nativeScreenKey(),pick=overrides[key]||surface.value;if(pick==='original')return null;const [top,bottom]=palettes[pick]||palettes.obsidian;const a=parseInt((palette[theme.value]||palette.violet).slice(1),16);const mix=(x,y,t)=>{let z=0;for(const b of [0,8,16])z|=Math.round(((x>>b)&255)*(1-t)+((y>>b)&255)*t)<<b;return z;};return {top:top|0xff000000,bottom:bottom|0xff000000,worldTop:top|0xad000000,worldBottom:bottom|0xd9000000,accent:a,border:mix(top,a,.48)|0xff000000,button:mix(top,bottom,.28)|0xf5000000};}
 function persistTheme(){save('al18-native',nativeMode.value);save('al18-surface',surface.value);save('al18-overrides',JSON.stringify(overrides));const p=palettes[surface.value]||palettes.obsidian;document.documentElement.style.setProperty('--al18-boot-top','#'+p[0].toString(16).padStart(6,'0'));document.documentElement.style.setProperty('--al18-boot-bottom','#'+p[1].toString(16).padStart(6,'0'));document.documentElement.style.setProperty('--al18-accent',palette[theme.value]||palette.violet);}
 nativeMode.onchange=surface.onchange=persistTheme;theme.onchange=()=>{applyTheme();persistTheme();};screenSelect.onchange=()=>{overrideSelect.value=overrides[screenSelect.value]||'inherit';};overrideSelect.onchange=()=>{const k=screenSelect.value;if(!k)return;if(overrideSelect.value==='inherit')delete overrides[k];else overrides[k]=overrideSelect.value;persistTheme();};$('al18-reset-theme').onclick=()=>{overrides=Object.create(null);nativeMode.value='theme';surface.value='obsidian';theme.value='violet';overrideSelect.value='inherit';applyTheme();persistTheme();};persistTheme();
 const ver=$('al16-version'),addr=$('al16-address');ver.value=load('al16-version','1.12.2');addr.value=load('al16-address','');function viaUpdate(){save('al16-version',ver.value);save('al16-address',addr.value);$('al16-via-info').textContent=ver.value==='1.12.2'?'Native version; an Eaglercraft WebSocket bridge is still required.':ver.value==='1.8.x'?'Requires an older-version translation setup on the server/proxy.':'Requires a newer-server translation setup (ViaVersion + ViaBackwards).';}ver.onchange=viaUpdate;addr.oninput=viaUpdate;viaUpdate();$('al16-copy').onclick=async()=>{try{const u=new URL(addr.value);if(!['ws:','wss:'].includes(u.protocol))throw Error();await navigator.clipboard.writeText(addr.value);$('al16-via-status').textContent='Copied. Paste in Multiplayer.';}catch(e){$('al16-via-status').textContent='Enter a valid ws:// or wss:// address. If clipboard is blocked, copy it manually.';}};
 const cosmeticStyles={cape:[["#c1c9d6","#20242c"],["#8faac8","#1d293d"],["#c8a66d","#333038"],["#a74a55","#272229"]],hat:[["#d0d8e5","#8490a3"],["#d9b775","#9c7840"],["#303b50","#9cb6d2"],["#292832","#a99ad0"],["#522a34","#ba6170"]]};const cosmeticFirst={cape:0,hat:0};function preview(kind){const el=$('al16-'+kind),i=Number(el.value)-cosmeticFirst[kind],p=cosmeticStyles[kind][i],box=$('al18-'+kind+'-preview');if(!p){box.textContent='No cosmetic';return;}const [a,b]=p;let path;if(kind==='cape'){path='<path d="M17 9H47V56H17Z" fill="'+b+'" stroke="#111722" stroke-width="1"/><path d="M'+(i===2?'30':'19')+' 11H'+(i===2?'34':'21')+'V54H'+(i===2?'30':'19')+'Z" fill="'+a+'"/><path d="M43 11H45V54H43Z" fill="'+a+'" opacity="'+(i===2?'.15':'1')+'"/>';}else{path=i===0?'<ellipse cx="32" cy="24" rx="21" ry="7" fill="none" stroke="'+a+'" stroke-width="3"/>':'<path d="M12 26H52V36H12Z" fill="'+a+'"/><path d="M12 26H52V28H12Z" fill="'+b+'"/><path d="M12 35H52" stroke="#111722"/>';}box.innerHTML='<svg viewBox="0 0 64 64" aria-hidden="true">'+path+'</svg>';}
 function selectCos(kind,index){const el=$('al16-'+kind);if(el.disabled)return;el.value=String(index);queue=queue.filter(q=>q.kind!==kind);queue.push({kind,index});preview(kind);$('al16-cos-status').textContent='Applying selection…';}for(const kind of ['cape','hat'])$('al16-'+kind).onchange=e=>selectCos(kind,Number(e.target.value));for(const b of root.querySelectorAll('[data-kit]'))b.onclick=()=>{const [c,h]=b.dataset.kit.split(',').map(Number);selectCos('cape',c<0?-1:cosmeticFirst.cape+c);selectCos('hat',h<0?-1:cosmeticFirst.hat+h);};
 const head=menu.querySelector('.al16-head');let drag=null;head.addEventListener('pointerdown',e=>{if(e.button!==0||e.target.closest('button'))return;const r=menu.getBoundingClientRect();drag={x:e.clientX-r.left,y:e.clientY-r.top};head.setPointerCapture(e.pointerId);menu.style.transform='none';menu.style.animation='none';menu.style.left=r.left+'px';menu.style.top=r.top+'px';});head.addEventListener('pointermove',e=>{if(!drag)return;menu.style.left=Math.max(0,Math.min(innerWidth-menu.offsetWidth,e.clientX-drag.x))+'px';menu.style.top=Math.max(0,Math.min(innerHeight-menu.offsetHeight,e.clientY-drag.y))+'px';});head.addEventListener('pointerup',()=>drag=null);head.addEventListener('pointercancel',()=>drag=null);function resetPos(){menu.style.left='';menu.style.top='';menu.style.transform='';menu.style.animation='';}$('al16-reset-pos').onclick=resetPos;window.addEventListener('resize',resetPos);$('al16-reset-mods').onclick=()=>{cfg={...defaults};save('aetherLegitHUD12',JSON.stringify(cfg));refresh();};
 const chatSelect=$('al22-chat');chatSelect.value=['0','1','2'].includes(load('al22-chat','0'))?load('al22-chat','0'):'0';function chatUpdate(){save('al22-chat',chatSelect.value);$('al22-chat-preview').dataset.mode=chatSelect.value;}chatSelect.onchange=chatUpdate;chatUpdate();const inputSelect=$('al23-input-mode');inputSelect.value=['0','1','2'].includes(load('al23-input','0'))?load('al23-input','0'):'0';function inputUpdate(){save('al23-input',inputSelect.value);$('al22-chat-preview').dataset.input=inputSelect.value;}inputSelect.onchange=inputUpdate;inputUpdate();
 window.AL12={hitbox(kind){return kind==='player'?!!cfg.playerboxes:kind==='item'?!!cfg.itemboxes:false;},hideClouds(){return !!cfg.clouds;},reduceParticles(){return !!cfg.particles;},nativeClick(a){if(a===mc&&a.r&&a.bD===null&&!open)nativeClickAt=performance.now();},attackDispatched(p){if(!mc||p!==mc.a||!mc.r||open)return;const now=performance.now();dispatchCount++;dispatchAt=now;const t=rawClickAt&&nativeClickAt>=rawClickAt&&nativeClickAt-rawClickAt<500?rawClickAt:nativeClickAt;dispatchMs=t&&now-t<1500?now-t:null;rawClickAt=nativeClickAt=0;},telemetry(){return {fps,frameMs:samples.length?samples.reduce((a,b)=>a+b,0)/samples.length:null,leftCps:left.length,rightCps:right.length,health:combat.player=== (mc&&mc.a)?combat.health:null,cooldown:combat.player===(mc&&mc.a)&&combat.cooldown!==null?combat.cooldown*100:null,sessionSeconds:started?Math.floor((performance.now()-started)/1000):0,clicks:totalClicks,dispatchMs,dispatchCount};},modPreset(p){for(const n of names)if(typeof p[n]==='boolean')cfg[n]=p[n];save('aetherLegitHUD12',JSON.stringify(cfg));refresh();},pvpSample(p,k,v){if(!mc||p!==mc.a||!Number.isFinite(v))return;if(combat.player!==p)combat={health:null,cooldown:null,player:p};if(k==="health")combat.health=v;else if(k==="cooldown")combat.cooldown=Math.max(0,Math.min(1,v));},inputMode(){return Number(inputSelect.value)||0;},inputAccent(){return (0xff000000|parseInt((palette[theme.value]||palette.violet).slice(1),16));},chatMode(){return Number(chatSelect.value)||0;},nativeTheme,screenClass:trackScreen,nativeReady:false,catalogReady:false,native(data){catalog=data;for(const [kind,values] of [['cape',data.caps],['hat',data.hats]]){const el=$('al16-'+kind);const first=Math.max(0,values.length-cosmeticStyles[kind].length);cosmeticFirst[kind]=first;el.replaceChildren(new Option('None','-1'),...values.slice(first).map((v,i)=>new Option(v,String(first+i))));const saved=load('al19-cos-'+kind,'None');const found=values.indexOf(saved,first);const selected=found>=first?found:-1;el.value=String(selected);el.disabled=false;queue.push({kind,index:selected});preview(kind);}$('al16-cos-status').textContent='Nine minimal styles ready · local third-person cosmetics.';this.catalogReady=true;},takeCosmetic(){return queue.shift()||null;},cosmeticApplied(kind,index){const values=kind==='cape'?catalog.caps:catalog.hats;save('al19-cos-'+kind,index<0?'None':values[index]);$('al16-cos-status').textContent='Applied · switch to third person to view.';},nativeError(){$('al16-cos-status').textContent='Native cosmetics could not initialize.';},game(a){mc=a;},screen(v){if(screen===v)return;const previous=screen;screen=v;if(open&&!(v==="pause"&&previous==="world"))panel(false);const badge=$("al13-stage-badge");const stages={welcome:["01 / FIRST LAUNCH","Welcome to Aether Legit"],profile:["02 / EDIT PROFILE","Personalize your player"]};badge.hidden=!stages[v];if(stages[v]){badge.querySelector("small").textContent=stages[v][0];badge.querySelector("strong").textContent=stages[v][1];badge.classList.remove("al13-animate");void badge.offsetWidth;badge.classList.add("al13-animate");}update();},frame(){if(!worldState()||document.hidden){last=0;frameCount=0;fpsAt=performance.now();return;}const n=performance.now();frameCount++;if(n-fpsAt>=1000){fps=Math.round(frameCount*1000/(n-fpsAt));frameCount=0;fpsAt=n;}if(last&&n-last<1000){samples.push(n-last);if(samples.length>60)samples.shift();}last=n;},begin(){cover=$('launch_countdown_screen');if(!cover)return;document.body.appendChild(cover);cover.classList.add('al12-active');cover.querySelector('.al-status').innerHTML='<span id="al12-stage">Starting browser engine</span><span id="al12-percent">12%</span>';cover.querySelector('.al-foot').textContent='Initializing the game engine…';this.stage('Starting browser engine',12);bootTimeout=setTimeout(()=>this.ready(),45000);},stage(label,p){if(finished||!cover)return;const l=$('al12-stage'),v=$('al12-percent'),bar=$('launchCountdownProgress');if(l)l.textContent=label;if(v)v.textContent=p+'%';if(bar)bar.style.width=p+'%';},ready(){if(finished||!cover)return;finished=true;clearTimeout(bootTimeout);cover.classList.add('al12-stage-fade');setTimeout(()=>cover&&cover.remove(),310);}};
 window.addEventListener('error',()=>{if(cover&&!finished)window.AL12.ready();});
})();
</script>

<script>
/* Aether Schematics: independent browser NBT reader and layer planner. */
(function(){
'use strict';
const MAX=4000000, LIMIT=48*1024*1024;
function nbt(bytes){const d=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);let p=0,nodes=0;const take=n=>{if(!Number.isSafeInteger(n)||n<0||p+n>d.byteLength)throw Error('Truncated or invalid NBT');const a=p;p+=n;return a;};const u=()=>d.getUint8(take(1)),i=()=>d.getInt32(take(4)),str=()=>{const n=d.getUint16(take(2));return new TextDecoder().decode(bytes.subarray(p,take(n)+n));};function val(t,depth=0){if(depth>48||++nodes>MAX+100000)throw Error('NBT complexity limit');switch(t){case 1:return d.getInt8(take(1));case 2:return d.getInt16(take(2));case 3:return i();case 4:return d.getBigInt64(take(8));case 5:return d.getFloat32(take(4));case 6:return d.getFloat64(take(8));case 7:{const n=i(),a=take(n);return bytes.slice(a,a+n);}case 8:return str();case 9:{const t=u(),n=i();if(n<0||n>MAX||(!t&&n))throw Error('Invalid NBT list');return Array.from({length:n},()=>val(t,depth+1));}case 10:{const o=Object.create(null);let t;while((t=u())!==0){const k=str();o[k]=val(t,depth+1);}return o;}case 11:{const n=i();if(n<0||n>MAX)throw Error('Invalid int array');return Int32Array.from({length:n},i);}case 12:{const n=i();if(n<0||n>MAX)throw Error('Invalid long array');return BigUint64Array.from({length:n},()=>d.getBigUint64(take(8)));}default:throw Error('Unsupported NBT tag '+t);}}if(u()!==10)throw Error('Expected NBT compound');str();return val(10);}
async function read(file){if(file.size>LIMIT)throw Error('File too large (48 MB maximum)');let b=new Uint8Array(await file.arrayBuffer());if(b[0]===31&&b[1]===139){const reader=new Blob([b]).stream().pipeThrough(new DecompressionStream('gzip')).getReader();let total=0,parts=[];while(true){const {done,value}=await reader.read();if(done)break;total+=value.length;if(total>LIMIT){await reader.cancel();throw Error('Expanded file exceeds 48 MB');}parts.push(value);}b=new Uint8Array(total);let p=0;for(const x of parts){b.set(x,p);p+=x.length;}}return nbt(b);}
const air=n=>/^(minecraft:)?(air|cave_air|void_air)$/.test(n), dimensions=(x,y,z)=>{if(![x,y,z].every(n=>Number.isInteger(n)&&n>0&&n<=4096)||x*y*z>MAX)throw Error('Region too large (4 million cells maximum)');return x*y*z;};
function decode(doc){let regions=[],sum=0;if(doc.Regions){for(const [name,r] of Object.entries(doc.Regions)){const s=r.Size,p=r.Position;if(!s||!p||!Array.isArray(r.BlockStatePalette)||!r.BlockStatePalette.length||!(r.BlockStates instanceof BigUint64Array))throw Error('Invalid Litematica region');const [w,h,l]=[s.x,s.y,s.z].map(Math.abs),n=dimensions(w,h,l);sum+=n;if(sum>MAX)throw Error('Combined regions too large');const palette=r.BlockStatePalette.map(v=>String(v.Name||'unknown'));const bits=Math.max(2,Math.ceil(Math.log2(palette.length))),B=BigInt(bits),mask=(1n<<B)-1n;if(r.BlockStates.length<Math.ceil(n*bits/64))throw Error('Incomplete block-state data');const data=new Uint32Array(n);for(let j=0;j<n;j++){const bit=j*bits,k=Math.floor(bit/64),off=bit%64;let v=r.BlockStates[k]>>BigInt(off);if(off+bits>64)v|=r.BlockStates[k+1]<<BigInt(64-off);const idx=Number(v&mask);if(idx>=palette.length)throw Error('Invalid palette index');data[j]=idx;}regions.push({name,w,h,l,palette,data,origin:[p.x+(s.x<0?s.x+1:0),p.y+(s.y<0?s.y+1:0),p.z+(s.z<0?s.z+1:0)]});}}else if(doc.Blocks instanceof Uint8Array){const w=doc.Width,h=doc.Height,l=doc.Length,n=dimensions(w,h,l);if(doc.Blocks.length!==n)throw Error('Invalid legacy block array');const palette=['minecraft:air'],ids=new Map([[0,0]]),data=new Uint32Array(n);for(let j=0;j<n;j++){const v=doc.Blocks[j]|((doc.AddBlocks?.[j>>1]||0)>>(j%2*4)&15)<<8;let k=ids.get(v);if(k===undefined){k=palette.length;ids.set(v,k);palette.push('Legacy block ID '+v);}data[j]=k;}regions=[{name:'Main region',w,h,l,palette,data,origin:[0,0,0]}];}else throw Error('Use .litematic or classic .schematic (Sponge .schem not yet supported)');if(!regions.length)throw Error('No regions found');return regions;}
function counts(r,y=null){const m=new Map(),start=y===null?0:y*r.w*r.l,end=y===null?r.data.length:start+r.w*r.l;for(let i=start;i<end;i++){const n=r.palette[r.data[i]];if(!air(n))m.set(n,(m.get(n)||0)+1);}return [...m].sort((a,b)=>b[1]-a[1]);}
const color=n=>{if(air(n))return '#151923';let h=0;for(const c of n)h=(Math.imul(h,31)+c.charCodeAt(0))|0;return `hsl(${(h>>>0)%360} 45% 57%)`;};
window.AetherSchematic={read,decode,counts,nbt};
const $=id=>document.getElementById(id),f=$('al21-file');if(!f)return;let regions=[],r=null,layer=0,serial=0;
const sel=$('al21-region'),range=$('al21-layer'),status=$('al21-status'),hud=$('al21-guide'),canvas=$('al21-preview'),mini=$('al21-mini'),check=$('al21-show');
function draw(c){if(!r)return;const scale=Math.min(1,640/Math.max(r.w,r.l));c.width=Math.max(1,Math.round(r.w*scale));c.height=Math.max(1,Math.round(r.l*scale));const ctx=c.getContext('2d');ctx.imageSmoothingEnabled=false;for(let z=0;z<c.height;z++)for(let x=0;x<c.width;x++){const n=r.palette[r.data[(layer*r.l+Math.floor(z*r.l/c.height))*r.w+Math.floor(x*r.w/c.width)]];ctx.fillStyle=color(n);ctx.fillRect(x,z,1,1);}}
function render(){if(!r)return;layer=Number(range.value);$('al21-layer-label').textContent=`Layer ${layer+1} / ${r.h} · relative Y ${r.origin[1]+layer}`;$('al21-size').textContent=`${r.w} × ${r.h} × ${r.l} blocks · region offset ${r.origin.join(', ')}`;draw(canvas);draw(mini);$('al21-mini-label').textContent=`${r.name} · layer ${layer+1}/${r.h}`;const list=$('al21-materials');list.replaceChildren();for(const [n,c] of counts(r,$('al21-layer-only').checked?layer:null).slice(0,500)){const row=document.createElement('div'),dot=document.createElement('i'),name=document.createElement('span'),qty=document.createElement('b');dot.style.background=color(n);name.textContent=n.replace(/^minecraft:/,'').replaceAll('_',' ');qty.textContent=c.toLocaleString();row.append(dot,name,qty);list.append(row);}}
function choose(){r=regions[Number(sel.value)];range.max=r.h-1;range.value=0;range.disabled=false;render();}sel.onchange=choose;range.oninput=render;$('al21-layer-only').onchange=render;$('al21-prev').onclick=()=>{if(r){range.value=Math.max(0,layer-1);render();}};$('al21-next').onclick=()=>{if(r){range.value=Math.min(r.h-1,layer+1);render();}};f.onchange=async()=>{const id=++serial,file=f.files[0];if(!file)return;status.textContent='Reading '+file.name+'…';try{const result=decode(await read(file));if(id!==serial)return;regions=result;sel.replaceChildren(...regions.map((v,i)=>new Option(v.name,String(i))));sel.disabled=false;choose();status.textContent=file.name+' · '+regions.length+' region(s) · local preview';}catch(e){if(id===serial)status.textContent=e.message;}};$('al21-export').onclick=()=>{if(!r)return;const a=document.createElement('a'),blob=new Blob([counts(r).map(([n,c])=>n+'\t'+c).join('\n')],{type:'text/plain'});a.href=URL.createObjectURL(blob);a.download='aether-materials.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);};window.AL21Guide={update(active,open){hud.hidden=!(r&&check.checked&&active&&!open);}};
})();

</script>

<script id="al24-loader">
(()=>{'use strict';
const $=id=>document.getElementById(id),storage='al24-mods-v1',list=$('al24-mod-list'),hud=$('al24-custom-hud'),status=$('al24-mod-status');
const fields={fps:' FPS',frameMs:' ms',leftCps:' CPS',rightCps:' CPS',health:' HP',cooldown:'%',sessionSeconds:' s',clicks:'',dispatchMs:' ms',dispatchCount:''};
const allowed=new Set(['keys','cps','frame','timer','clock','fps','clicks','focus','coords','speed','direction','cross','mark','cooldown','vitals','peak','mouse','rhythm','playerboxes','itemboxes','dispatch','particles','clouds']);
const example={format:'aethermod',api:1,id:'combat-readout',name:'Combat Readout',version:'1.0',description:'A compact local attack and frame-time readout.',widgets:[{label:'Attack processing',source:'dispatchMs'},{label:'Frame time',source:'frameMs'}],preset:{cooldown:true,dispatch:true}};
let mods=[],nodes=[];
function validate(x){if(!x||x.format!=='aethermod'||x.api!==1||typeof x.id!=='string'||!/^[a-z0-9][a-z0-9_-]{0,47}$/.test(x.id)||typeof x.name!=='string'||!x.name.trim()||x.name.length>64)throw Error('Invalid Aether mod manifest. Expected format aethermod, api 1, id and name.');const w=x.widgets??[];if(!Array.isArray(w)||w.length>6)throw Error('Maximum six widgets per mod.');const widgets=w.map(a=>{if(!a||typeof a.label!=='string'||!a.label.trim()||a.label.length>50||!Object.hasOwn(fields,a.source))throw Error('Invalid HUD widget source or label.');return {label:a.label,source:a.source};});const preset={};if(x.preset!==undefined){if(!x.preset||typeof x.preset!=='object'||Array.isArray(x.preset))throw Error('Invalid preset.');for(const [k,v] of Object.entries(x.preset)){if(!allowed.has(k)||typeof v!=='boolean')throw Error('Unknown module or invalid toggle: '+k);preset[k]=v;}}if(!widgets.length&&!Object.keys(preset).length)throw Error('Mod must supply a widget or preset.');return {format:'aethermod',api:1,id:x.id,name:x.name,version:typeof x.version==='string'?x.version.slice(0,20):'1.0',description:typeof x.description==='string'?x.description.slice(0,240):'',widgets,preset,enabled:x.enabled!==false};}
function persist(){try{localStorage.setItem(storage,JSON.stringify(mods));}catch(e){status.textContent='Browser storage unavailable; mods work until reload.';}}
function make(tag,cls,txt){const n=document.createElement(tag);if(cls)n.className=cls;if(txt!==undefined)n.textContent=txt;return n;}
function render(){list.replaceChildren();hud.replaceChildren();nodes=[];if(!mods.length)list.append(make('p','','No external mods installed.'));for(const m of mods){const row=make('div','al24-mod-row'),text=make('div');text.append(make('strong','',m.name+' · '+m.version),make('p','',m.description||m.widgets.length+' HUD widgets'));const buttons=make('div','al24-mod-actions');const enable=make('button','al16-action',m.enabled?'Enabled':'Disabled');enable.onclick=()=>{m.enabled=!m.enabled;persist();render();};buttons.append(enable);if(Object.keys(m.preset).length){const p=make('button','al16-action','Apply preset');p.disabled=!m.enabled;p.onclick=()=>{window.AL12.modPreset(m.preset);status.textContent='Applied '+m.name+' preset.';};buttons.append(p);}const remove=make('button','al16-action','Remove');remove.onclick=()=>{mods=mods.filter(a=>a.id!==m.id);persist();render();};buttons.append(remove);row.append(text,buttons);list.append(row);if(m.enabled)for(const w of m.widgets){const box=make('div','al12-widget al24-widget'),value=make('div','al12-value','—');box.append(make('div','al12-label',w.label),value);hud.append(box);nodes.push({w,value});}}}
function install(x){const m=validate(x),i=mods.findIndex(a=>a.id===m.id);if(i<0&&mods.length>=8)throw Error('Maximum eight installed mods.');if(i>=0)mods[i]=m;else mods.push(m);status.textContent='Installed '+m.name+'.';persist();render();}
try{const saved=JSON.parse(localStorage.getItem(storage)||'[]');if(Array.isArray(saved))for(const m of saved.slice(0,8))try{mods.push(validate(m));}catch(e){}}catch(e){}
$('al24-import').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;try{if(!/\.(aethermod|json)$/i.test(f.name)||f.size>65536)throw Error('Choose a .aethermod or JSON file under 64 KB.');install(JSON.parse(await f.text()));}catch(err){status.textContent=err.message;}finally{e.target.value='';}});
$('al24-example').onclick=()=>{try{install(example);}catch(e){status.textContent=e.message;}};
window.AL24Mods={tick(){if(!nodes.length)return;const d=window.AL12.telemetry();for(const {w,value} of nodes){const n=d[w.source];value.textContent=Number.isFinite(n)?(Math.round(n*10)/10)+fields[w.source]:'—';}}};render();
})();
</script>
<script id="al25-catalog">(()=>{'use strict';const status=document.getElementById('al25-status');for(const b of document.querySelectorAll('.al25-copy'))b.onclick=async()=>{const input=b.parentElement.querySelector('input');try{if(!navigator.clipboard)throw Error();await navigator.clipboard.writeText(input.value);status.textContent='Copied. Paste into Minecraft chat in a cheats-enabled world.';}catch(e){input.focus();input.select();try{if(!document.execCommand('copy'))throw Error();status.textContent='Copied.';}catch(e){status.textContent='Command selected. Press Ctrl+C to copy.';}}};})();</script>
<script id="al26-palettes-js">(()=>{'use strict';const PATCH={"deep":{"assets/minecraft/textures/blocks/stone_andesite.png":"","assets/minecraft/textures/blocks/cobblestone.png":"","assets/minecraft/textures/blocks/stonebrick.png":"","assets/minecraft/textures/blocks/brick.png":"","assets/minecraft/textures/blocks/nether_brick.png":"","assets/minecraft/textures/blocks/stonebrick_cracked.png":"","assets/minecraft/textures/blocks/red_nether_brick.png":"","assets/minecraft/textures/blocks/stonebrick_carved.png":"","assets/minecraft/textures/blocks/bedrock.png":"","assets/minecraft/textures/blocks/coal_ore.png":"","assets/minecraft/textures/blocks/iron_ore.png":"","assets/minecraft/textures/blocks/gold_ore.png":"","assets/minecraft/textures/blocks/diamond_ore.png":"","assets/minecraft/textures/blocks/emerald_ore.png":"","assets/minecraft/textures/blocks/lapis_ore.png":"","assets/minecraft/textures/blocks/redstone_ore.png":"","assets/minecraft/textures/blocks/quartz_ore.png":""},"wall_polished":{"assets/minecraft/models/block/cobblestone_wall_mossy_inventory.json":"RklMRUNhc3NldHMvbWluZWNyYWZ0L21vZGVscy9ibG9jay9jb2JibGVzdG9uZV93YWxsX21vc3N5X2ludmVudG9yeS5qc29uAAAATkM0+eF7InBhcmVudCI6ImJsb2NrL3dhbGxfaW52ZW50b3J5IiwidGV4dHVyZXMiOnsid2FsbCI6ImJsb2Nrcy9zdG9uZWJyaWNrIn19Oj4=","assets/minecraft/models/block/mossy_cobblestone_wall_post.json":"RklMRT5hc3NldHMvbWluZWNyYWZ0L21vZGVscy9ibG9jay9tb3NzeV9jb2JibGVzdG9uZV93YWxsX3Bvc3QuanNvbgAAAEneA/ceeyJwYXJlbnQiOiJibG9jay93YWxsX3Bvc3QiLCJ0ZXh0dXJlcyI6eyJ3YWxsIjoiYmxvY2tzL3N0b25lYnJpY2sifX06Pg==","assets/minecraft/models/block/mossy_cobblestone_wall_side.json":"RklMRT5hc3NldHMvbWluZWNyYWZ0L21vZGVscy9ibG9jay9tb3NzeV9jb2JibGVzdG9uZV93YWxsX3NpZGUuanNvbgAAAEnVDQ+BeyJwYXJlbnQiOiJibG9jay93YWxsX3NpZGUiLCJ0ZXh0dXJlcyI6eyJ3YWxsIjoiYmxvY2tzL3N0b25lYnJpY2sifX06Pg=="},"wall_bricks":{"assets/minecraft/models/block/cobblestone_wall_mossy_inventory.json":"RklMRUNhc3NldHMvbWluZWNyYWZ0L21vZGVscy9ibG9jay9jb2JibGVzdG9uZV93YWxsX21vc3N5X2ludmVudG9yeS5qc29uAA