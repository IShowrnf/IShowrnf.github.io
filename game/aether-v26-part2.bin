<style>
    #launch_countdown_screen{position:fixed;inset:0;display:grid;place-items:center;overflow:hidden;background:radial-gradient(ellipse at 22% 16%,#26204a 0,transparent 46%),radial-gradient(ellipse at 85% 75%,#112b46 0,transparent 48%),#080b15;color:#f3f5ff;font:14px/1.5 system-ui,Segoe UI,sans-serif;user-select:none}
    #launch_countdown_screen::before{content:"";position:absolute;inset:0;background-image:linear-gradient(#a9b9ff09 1px,transparent 1px),linear-gradient(90deg,#a9b9ff09 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(#000,transparent 95%);pointer-events:none}
    .al-card{position:relative;width:min(390px,calc(100vw - 64px));padding:36px 28px 28px;box-sizing:border-box;border:1px solid #53648b55;border-radius:24px;background:linear-gradient(150deg,#172137f2,#0b1020f2);box-shadow:0 28px 100px #0008;animation:al-enter .6s cubic-bezier(.2,.8,.2,1) both;text-align:center}
    .al-mark{width:68px;height:68px;margin:0 auto 18px;border-radius:19px;display:grid;place-items:center;background:linear-gradient(145deg,#9874ff,#57c9ff);box-shadow:0 0 34px #9874ff44;color:#0a1225}
    .al-word{font-size:32px;line-height:1.05;letter-spacing:-1.5px;font-weight:900}.al-word span{color:#a694ff}.al-meta{font-size:11px;letter-spacing:2px;color:#91a3c3;margin-top:10px;font-weight:600}.al-line{height:1px;background:#344260;margin:28px 0 22px}.al-status{display:flex;justify-content:space-between;gap:10px;color:#bdcce6;font-size:12px}.al-progress{height:5px;border-radius:9px;background:#27334b;margin:10px 0 18px;overflow:hidden}#launchCountdownProgress{height:100%;width:0%;background:linear-gradient(90deg,#9874ff,#57c9ff);border-radius:9px;transition:width 90ms linear}.al-button{width:100%;border:0;border-radius:10px;padding:12px;background:#a694ff;color:#11182a;font-weight:800;cursor:pointer;transition:background .15s,transform .15s}.al-button:hover{background:#c2b6ff;transform:translateY(-1px)}.al-button:focus-visible{outline:2px solid #57c9ff;outline-offset:4px}.al-foot{font-size:11px;color:#8293b2;margin-top:15px}.al-version{position:absolute;left:22px;bottom:18px;font-size:11px;color:#8293b2;letter-spacing:1px}@keyframes al-enter{from{opacity:0;transform:translateY(14px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}@media(prefers-reduced-motion:reduce){.al-card{animation:none}.al-button,#launchCountdownProgress{transition:none}}
    </style>
<style id="al16-style">
