#al12-root.al14-open{pointer-events:auto;background:#05060a92}.al12-menu{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(920px,calc(100vw - 30px));height:min(610px,calc(100vh - 30px));border:1px solid #343646;border-radius:18px;overflow:hidden;background:#12131b;box-shadow:0 24px 90px #000b;display:grid;grid-template-columns:190px minmax(0,1fr);animation:al16-in .19s ease-out;outline:none}@keyframes al16-in{from{opacity:0;transform:translate(-50%,-48%) scale(.98)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}.al16-side{background:#191a24;border-right:1px solid #2c2e3c;display:flex;flex-direction:column;padding:20px 12px;gap:6px;min-height:0;overflow:auto}.al16-brand{display:flex;align-items:center;gap:10px;padding:3px 7px 23px}.al16-logo{width:35px;height:35px;background:var(--accent);color:#131321;border-radius:11px;display:grid;place-items:center;font-size:24px;font-weight:900}.al16-brand strong{font-size:16px;letter-spacing:-.5px;display:block}.al16-brand small,.al16-muted{color:#9799ad;font-size:11px}.al16-nav{display:flex;align-items:center;gap:10px;border:0;color:#b8bbcc;background:transparent;padding:10px 12px;border-radius:8px;text-align:left;font-weight:600!important}.al16-nav span{width:18px;text-align:center;color:#a4a5ba}.al16-nav[aria-selected=true]{background:#2b2a40;color:#f4f2ff}.al16-nav[aria-selected=true] span{color:var(--accent)}.al16-side-foot{margin-top:auto;padding:12px 8px;color:#8e91a5;font-size:11px}.al16-side-foot b{color:var(--accent);display:block;margin-bottom:6px}.al16-main{min-width:0;min-height:0;display:flex;flex-direction:column}.al16-head{padding:20px 24px 15px;border-bottom:1px solid #272935;display:flex;justify-content:space-between;gap:12px;align-items:center;cursor:move;touch-action:none}.al16-head h2{margin:2px 0;font-size:24px;letter-spacing:-.7px}.al16-kicker{font-size:10px;color:var(--accent);letter-spacing:1.5px;text-transform:uppercase;font-weight:700}.al12-close{border:1px solid #353747;border-radius:8px;background:#232530;color:#d9dbe8;width:34px;height:34px;font-size:20px!important}.al16-toolbar{display:flex;gap:10px;align-items:center;padding:14px 24px 0}.al16-search{min-width:0;flex:1;background:#1b1d28;color:#f2f2fa;border:1px solid #323444;border-radius:8px;padding:10px 12px;user-select:text}.al16-count{color:#a4a6ba;font-size:11px;white-space:nowrap}.al16-body{flex:1;min-height:0;overflow:auto;padding:18px 24px;scrollbar-width:thin;scrollbar-color:#42445a transparent}.al12-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.al12-option{display:grid;grid-template-columns:35px minmax(0,1fr) 34px;align-items:center;gap:11px;min-height:78px;padding:13px;border:1px solid #2d303e;border-radius:10px;background:#1b1d28;text-align:left;color:#eef0fa;transition:border-color .15s,background .15s}.al12-option:hover{border-color:#686982;background:#202230}.al12-option[aria-pressed=true]{border-color:#625c95;background:#222337}.al12-hotkey{width:35px;height:35px;border-radius:8px;display:grid;place-items:center;background:#292b3a;color:#b1b4ce;font-weight:700}.al12-option[aria-pressed=true] .al12-hotkey{color:var(--accent)}.al12-option-copy strong{display:block;font-size:13px;margin-bottom:3px}.al12-option-copy small{display:block;color:#a1a4b8;font-size:11px;line-height:1.35}.al12-option b{font-size:0;width:34px;height:19px;border-radius:12px;background:#414454;position:relative}.al12-option b:after{content:"";position:absolute;left:3px;top:3px;width:13px;height:13px;border-radius:50%;background:#d3d5e1;transition:transform .15s}.al12-option[aria-pressed=true] b{background:var(--accent)}.al12-option[aria-pressed=true] b:after{transform:translateX(15px);background:#171826}.al16-footer{padding:11px 24px;border-top:1px solid #272935;display:flex;justify-content:space-between;color:#9295aa;font-size:11px;gap:10px}.al16-card{border:1px solid #303240;border-radius:12px;background:#1b1d28;padding:16px;margin-bottom:12px}.al16-card h3{margin:0 0 8px;font-size:16px}.al16-card p{color:#a9acbf;margin:6px 0 12px}.al16-card label{display:block;color:#b6b8cb;margin:12px 0 5px;font-size:12px}.al16-card select,.al16-card input{width:100%;padding:10px;background:#11131c;border:1px solid #37394b;border-radius:8px;color:#e9ebf7;user-select:text}.al16-action{border:0;border-radius:8px;padding:9px 13px;background:var(--accent);color:#141523;font-weight:700!important;margin:10px 6px 0 0}.al16-cos-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.al16-preview{height:105px;display:grid;place-items:center;background:radial-gradient(ellipse,#3b325e,#141620 70%);border-radius:9px;color:var(--accent);font-size:42px}.al16-preview svg{width:70px;height:70px}.al16-status{color:#bdb4ff;font-size:12px;min-height:18px}.al12-hud{position:absolute;right:18px;top:55px;display:grid;gap:7px;width:150px;max-height:calc(100vh - 65px);overflow:hidden}.al12-widget{background:#11131cbb;border:1px solid #4c4f6566;border-radius:9px;padding:8px 10px}.al12-label{font-size:9px;color:#b3b6c9;letter-spacing:.8px;text-transform:uppercase}.al12-value{font-size:15px;font-weight:750;font-variant-numeric:tabular-nums}.al12-keys{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;text-align:center}.al12-key{border:1px solid #55586b;border-radius:5px;background:#252734;padding:5px 0;font-weight:700}.al12-key.on{background:var(--accent);color:#11121b}.al12-key[data-key=Space]{grid-column:1/4}.al12-graph{width:120px;height:27px;display:block}.al16-cross{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:var(--accent);font-size:20px;text-shadow:0 0 3px #000;line-height:1}.al16-mark{position:absolute;left:14px;top:12px;background:#141620bb;color:#f4f3ff;border-radius:7px;padding:7px 10px;font-weight:750;letter-spacing:.6px}.al16-mark span{color:var(--accent)}#al13-entry{position:absolute;right:16px;top:14px;pointer-events:auto;background:#191b27e8;color:#e9e7ff;border:1px solid #5e597e;border-radius:8px;padding:8px 11px;font:700 11px system-ui;cursor:pointer}#al13-stage-badge[hidden]{display:none!important}#al13-stage-badge{position:fixed;top:12px;left:12px;z-index:2147483645;display:flex;gap:10px;align-items:center;color:#e9eaff;background:#10182eea;border:1px solid #8775dc99;padding:9px 12px;border-radius:12px;font:12px system-ui,sans-serif;pointer-events:none}#al13-stage-badge span{color:#ad9bff;font-size:24px}#al13-stage-badge small,#al13-stage-badge strong{display:block}#al13-stage-badge small{color:#a99bff;font-size:9px;letter-spacing:1px}#al13-stage-badge em{font:9px system-ui;color:#9aacd1;margin-left:10px}.al13-animate{animation:al-enter .35s ease both}.al12-stage-fade{opacity:0!important;transition:opacity .28s ease!important;pointer-events:none!important}#launch_countdown_screen.al12-active{z-index:2147483647;pointer-events:none}#launch_countdown_screen.al12-active .al-button{display:none}@media(max-width:650px){.al12-menu{grid-template-columns:115px minmax(0,1fr)}.al16-side{padding:12px 5px}.al16-brand{padding:3px 3px 15px;flex-direction:column;align-items:flex-start}.al16-nav{padding:8px 5px}.al12-grid,.al16-cos-grid{grid-template-columns:1fr}.al16-head,.al16-body{padding:13px}.al16-toolbar,.al16-footer{padding-left:13px;padding-right:13px}}@media(prefers-reduced-motion:reduce){.al12-menu{animation:none}.al12-option,.al12-option b:after{transition:none}}
