:root{--al18-boot-top:#161923;--al18-boot-bottom:#090b12;--al18-accent:#a59bff}#launch_countdown_screen{background:radial-gradient(ellipse at 30% 0%,var(--al18-boot-top),transparent 70%),var(--al18-boot-bottom)}#launchCountdownProgress,.al-mark,.al-button{background:var(--al18-accent)}.al-word span{color:var(--al18-accent)}#al13-stage-badge{border-color:var(--al18-accent)}#al13-stage-badge span,#al13-stage-badge small{color:var(--al18-accent)}.al18-overline{font-size:10px;letter-spacing:1.8px;color:var(--accent);font-weight:700;margin-bottom:10px}.al18-preset{display:flex;flex-wrap:wrap;gap:4px;margin:8px 0}.al18-preset .al16-action{background:#222432;color:#f2f2ff;border:1px solid #414458;padding:7px 10px;margin:0}.al18-preset .al16-action:hover{border-color:var(--accent)}.al18-divider{height:1px;background:#373846;margin:20px 0}.al16-preview{height:120px;background:radial-gradient(ellipse at 50% 25%,#2e3040,#141620);border:1px solid #343747;border-radius:12px;color:#aaaec2}.al16-preview svg{width:88px;height:88px}.al16-card select{margin-bottom:8px}.al16-card h3{letter-spacing:-.4px}.al16-body{scrollbar-color:#47495b transparent}
